function loadCalcDrugs(){
  try{
    const raw = localStorage.getItem(CALC_STORAGE_KEY);
    if(raw){
      const parsed = JSON.parse(raw);
      if(Array.isArray(parsed) && parsed.length) return parsed;
    }
  }catch(e){}
  return JSON.parse(JSON.stringify(DEFAULT_CALC_DRUGS));
}

function saveCalcDrugs(){
  localStorage.setItem(CALC_STORAGE_KEY, JSON.stringify(calcDrugs));
}

let calcDrugs = loadCalcDrugs();

function renderCalcSelect(){
  const sel = document.getElementById("drugSelect");
  sel.innerHTML = '<option value="">-- 請選擇藥物 --</option>';

  let sorted = calcDrugs.slice().sort((a,b)=>{
    if(a.ctrl && !b.ctrl) return -1;
    if(!a.ctrl && b.ctrl) return 1;
    return a.label.localeCompare(b.label, 'en');
  });

  let ctrlGroup = sorted.filter(d=>d.ctrl);
  let genGroup = sorted.filter(d=>!d.ctrl);

  function createOpt(d){
    let opt = document.createElement("option");
    opt.value = d.id;
    opt.textContent = d.label;
    if(d.ctrl) opt.className = 'ctrl';
    Object.keys(d).forEach(k => { if(k!=='id' && k!=='label') opt.dataset[k] = d[k]; });
    return opt;
  }

  if(ctrlGroup.length){
    let g = document.createElement("optgroup");
    g.label = '── 管制藥品 ──';
    ctrlGroup.forEach(d => g.appendChild(createOpt(d)));
    sel.appendChild(g);
  }
  if(genGroup.length){
    let g = document.createElement("optgroup");
    g.label = '── 一般藥品 (A-Z) ──';
    genGroup.forEach(d => g.appendChild(createOpt(d)));
    sel.appendChild(g);
  }
  resetCalcForm();
}

function resetCalcForm(){
  const opt = document.getElementById("drugSelect").selectedOptions[0];
  const unitMap = { mg:'mg', mcg:'mcg', IU:'IU', amp:'Amp', bot:'bot', tab:'mg' };
  const uEl = document.getElementById("doseUnit");
  const dBox = document.getElementById("calcDetail");
  const tBtn = document.getElementById("toggleDetailBtn");

  if(!opt || !opt.dataset || !opt.dataset.type){
    uEl.textContent = '';
    dBox.classList.add("hidden");
    dBox.innerHTML = '';
    tBtn.classList.add("hidden");
    detailOpen = false;
  } else {
    uEl.textContent = unitMap[opt.dataset.type] || '';
    showCalcDrugDetail(opt);
    tBtn.classList.remove("hidden");
    if(detailOpen) dBox.classList.remove("hidden");
    else dBox.classList.add("hidden");
  }

  document.getElementById("doseInput").value = '';
  document.getElementById("resultLive").innerHTML = '';
  document.getElementById("dilutionBlock").classList.add("hidden");
}

function toggleCalcDetail(){
  detailOpen = !detailOpen;
  const dBox = document.getElementById("calcDetail");
  const tBtn = document.getElementById("toggleDetailBtn");
  if(detailOpen){
    dBox.classList.remove("hidden");
    tBtn.innerHTML = '📦 收合藥物總量明細 ▲';
  } else {
    dBox.classList.add("hidden");
    tBtn.innerHTML = '📦 顯示藥物總量明細 ▼';
  }
}

function showCalcDrugDetail(opt){
  const type = opt.dataset.type;
  const unitMap = { mg:'mg', mcg:'mcg', IU:'IU', amp:'Amp', bot:'bot', tab:'tab' };
  const unit = unitMap[type] || '';
  const strength = parseFloat(opt.dataset.strength);
  const ampml = parseFloat(opt.dataset.ampml);
  const botml = parseFloat(opt.dataset.botml);
  const totalml = parseFloat(opt.dataset.totalml);
  const totalamount = parseFloat(opt.dataset.totalamount);
  const amountunit = opt.dataset.amountunit || (type==='tab'?'mg':unit);
  const base = parseFloat(opt.dataset.base);
  const lowth = parseFloat(opt.dataset.lowth || '5');

  let lines = [];
  lines.push('<div class="title">📦 藥物總容量明細</div>');
  lines.push('<div><strong>品項:</strong> ' + opt.textContent.trim() + '</div>');

  if(['mg','mcg','IU'].includes(type)){
    if(!isNaN(strength)) lines.push('<div><strong>濃度:</strong> ' + strength + ' ' + unit + '/mL</div>');
    if(!isNaN(totalml) && !isNaN(totalamount)){
      let dispAmt = totalamount, dispUnit = amountunit;
      if(amountunit === 'mcg' && totalamount >= 1000){ dispAmt /= 1000; dispUnit = 'mg'; }
      lines.push('<div><strong>包裝總量:</strong> ' + dispAmt + ' ' + dispUnit + ' / ' + totalml + ' mL</div>');
    } else if(!isNaN(totalml)){
      lines.push('<div><strong>包裝總量:</strong> ' + totalml + ' mL</div>');
    }
  }

  if(type === 'amp'){
    if(!isNaN(ampml)) lines.push('<div><strong>1 Amp =</strong> ' + ampml + ' mL</div>');
    if(!isNaN(totalamount)) lines.push('<div><strong>每支含量:</strong> ' + totalamount + ' ' + amountunit + ' / Amp</div>');
  }

  if(type === 'bot' && !isNaN(botml)) lines.push('<div><strong>1 bot =</strong> ' + botml + ' mL</div>');

  if(type === 'tab'){
    if(!isNaN(strength)) lines.push('<div><strong>每顆含量:</strong> ' + strength + ' mg / tab</div>');
    const pack = parseFloat(opt.dataset.packcount);
    if(!isNaN(pack) && !isNaN(strength)){
      lines.push('<div><strong>每瓶總量:</strong> ' + pack + ' tab / bot（' + (pack*strength).toFixed(1) + ' mg）</div>');
    }
  }

  if(!isNaN(base)){
    let dispBase = base, u = (type === 'mcg') ? 'mcg' : 'mg';
    if(type === 'mcg' && base >= 100){ dispBase /= 1000; u = 'mg'; }
    lines.push('<div><strong>低劑量稀釋基準:</strong> ' + dispBase + ' ' + u + ' / 0.1 mL（低於 ' + lowth + ' 觸發提示）</div>');
  }

  document.getElementById("calcDetail").innerHTML = lines.join('');
}

function doCalculate(silent = false){
  const opt = document.getElementById("drugSelect").selectedOptions[0];
  if(!opt || !opt.dataset || !opt.dataset.type){ if(!silent) alert('請先選藥'); return; }

  const doseVal = parseFloat(document.getElementById("doseInput").value);
  if(!doseVal || doseVal <= 0){ if(!silent) alert('請輸入正確劑量'); return; }

  const type = opt.dataset.type;
  const special = opt.dataset.special;
  let ml = null, text = '';

  const strength = parseFloat(opt.dataset.strength || '0');
  const ampml = parseFloat(opt.dataset.ampml || '0');
  const botml = parseFloat(opt.dataset.botml || '0');

  if(['mg','mcg','IU'].includes(type)){
    ml = doseVal / strength;
    text = '👉 抽取 ' + ml.toFixed(2) + ' mL';
  } else if(type === 'amp'){
    ml = doseVal * ampml;
    text = '👉 抽取 ' + ml.toFixed(1) + ' mL';
  } else if(type === 'bot'){
    ml = doseVal * botml;
    text = '👉 抽取 ' + ml.toFixed(1) + ' mL';
  } else if(type === 'tab'){
    let tab = doseVal / strength;
    text = '👉 給 ' + tab.toFixed(1) + ' 顆 (' + doseVal + ' mg)';
  }

  let warningText = '';
  if(ml !== null && ml <= 0.1) warningText = '⚠ ≤0.1 mL 建議稀釋使用';
  else if(ml !== null && ml < 1) warningText = '⚠ 抽取量 <1 mL 請注意';

  let hintText = '';
  const lowList = ['fentanyl','meperidine','morphine','propofol','norepinephrine'];
  const lowth = parseFloat(opt.dataset.lowth || '5');

  if(lowList.includes(special) && doseVal < lowth){
    document.getElementById("dilutionBlock").classList.remove("hidden");
    const finalVol = parseFloat(document.getElementById("dilutionSelect").value);
    const base = parseFloat(opt.dataset.base || '5');
    const push = (doseVal * finalVol) / base;

    let hintBase = base, hintUnit = (type === 'mcg') ? 'mcg' : 'mg';
    if(type === 'mcg' && base >= 100){ hintBase /= 1000; hintUnit = 'mg'; }
    hintText = `💡 低劑量建議<br>抽 ${hintBase} ${hintUnit}/0.1mL → 稀釋 ${finalVol}mL → 推 ${push.toFixed(1)}mL`;
  } else {
    document.getElementById("dilutionBlock").classList.add("hidden");
  }

  const live = document.getElementById("resultLive");
  live.innerHTML = '';
  setTimeout(()=>{
    let parts = [];
    if(text) parts.push(`<div class="calc-result">${text}</div>`);
    if(warningText) parts.push(`<div class="calc-warning">${warningText}</div>`);
    if(hintText) parts.push(`<div class="calc-hint">${hintText}</div>`);
    live.innerHTML = parts.join('');
  }, 80);

  showCalcDrugDetail(opt);
}

