function openEditModalTB(idx){
  editTbIndex = idx;
  let d = tbDrugs[idx];
  document.getElementById("tbModalTitle").textContent = "編輯藥物";
  document.getElementById("fName").value = d.name;
  document.getElementById("fCategory").value = d.category;
  document.getElementById("fRisk").value = d.risk;
  document.getElementById("fIndication").value = d.indication;
  document.getElementById("fAdr").value = d.adr.join("\n");
  document.getElementById("fDose").value = d.dose;
  document.getElementById("fWarning").value = d.warning.join("\n");
  document.getElementById("fLowDose").value = d.lowDoseConc || "";
  document.getElementById("tbModalOverlay").classList.add("show");
}

function closeTbModal(){ document.getElementById("tbModalOverlay").classList.remove("show"); }

function saveTbDrug(){
  let name = document.getElementById("fName").value.trim();
  if(!name){ showToast("請輸入藥物名稱"); return; }
  let obj = {
    name: name,
    category: document.getElementById("fCategory").value,
    risk: document.getElementById("fRisk").value,
    indication: document.getElementById("fIndication").value.trim(),
    adr: document.getElementById("fAdr").value.trim().split("\n").map(s=>s.trim()).filter(Boolean),
    dose: document.getElementById("fDose").value.trim(),
    warning: document.getElementById("fWarning").value.trim().split("\n").map(s=>s.trim()).filter(Boolean),
    lowDoseConc: document.getElementById("fLowDose").value.trim() || ""
  };

  if(editTbIndex >= 0) tbDrugs[editTbIndex] = obj;
  else tbDrugs.push(obj);

  saveTbDrugsToStorage(tbDrugs);
  closeTbModal();
  renderTbAdmin();
  renderToolboxFront();
  showToast("✅ 藥物資料已儲存");
}

function deleteTbDrug(idx){
  if(!confirm(`確定要刪除「${tbDrugs[idx].name}」嗎？`)) return;
  tbDrugs.splice(idx, 1);
  saveTbDrugsToStorage(tbDrugs);
  renderTbAdmin();
  renderToolboxFront();
  showToast("🗑 藥物已刪除");
}

