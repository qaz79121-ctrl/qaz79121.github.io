function loadTbDrugs(){
  let saved = localStorage.getItem(TB_STORAGE_KEY);
  if(saved){
    try{ return JSON.parse(saved); }catch(e){}
  }
  saveTbDrugsToStorage(defaultTbDrugs);
  return JSON.parse(JSON.stringify(defaultTbDrugs));
}

function saveTbDrugsToStorage(data){
  localStorage.setItem(TB_STORAGE_KEY, JSON.stringify(data));
}

let tbDrugs = loadTbDrugs();
let currentCategory = "全部";
let currentRisk = "all";

function safeRisk(r){ return (r === "high") ? "high" : "medium"; }

function renderToolboxFront(){
  let keyword = document.getElementById("searchToolbox").value.toLowerCase();
  let html = "";
  let count = 0;

  tbDrugs.forEach((d, i)=>{
    if(currentCategory !== "全部" && d.category !== currentCategory) return;
    if(currentRisk !== "all" && d.risk !== currentRisk) return;

    let fullText = (d.name + d.indication + d.adr.join(" ") + d.dose + d.warning.join(" ")).toLowerCase();
    if(keyword && !fullText.includes(keyword)) return;

    count++;
    let lowDoseClass = (d.lowDoseConc && (d.lowDoseConc.includes('無法換算') || d.lowDoseConc.includes('不適用') || d.lowDoseConc.includes('無固定濃度'))) ? 'lowdose-na' : '';
    let risk = safeRisk(d.risk);

    html += `
    <div class="card drug-card risk-${risk}">
      <div class="drug-card-header">
        <span class="drug-name">${escapeHtml(d.name)}</span>
        <span class="category-tag">${escapeHtml(d.category)}</span>
        <span class="tag risk-${risk}">${risk === "high" ? "🚨 高風險" : "⚠ 注意"}</span>
      </div>

      <div class="lowdose-box">
        <b>低劑量濃度(不稀釋)：</b>
        <span class="${lowDoseClass}">${d.lowDoseConc ? escapeHtml(d.lowDoseConc) : '未提供'}</span>
      </div>

      <p style="margin:6px 0;"><b>適應症：</b>${escapeHtml(d.indication)}</p>

      <p style="background:#fff1f0;padding:8px 12px;border-radius:8px;margin:6px 0;">
        <b style="color:#cf1322;">副作用：</b>
        <span style="color:#cf1322;">${d.adr.map(escapeHtml).join("、")}</span>
      </p>

      <p class="dose-text" style="margin:6px 0;"><b>用藥：</b>${escapeHtml(d.dose)}</p>

      <div class="toggle-btn" onclick="toggleTbWarn(${i}, this)">▶ 點擊展開注意事項</div>
      <div id="tbWarn${i}" class="hidden warning-text">
        ${d.warning.map(w=>`<p style="margin:4px 0;">⚠ ${escapeHtml(w)}</p>`).join("")}
      </div>
    </div>`;
  });

  if(count === 0){
    html = `<div style="text-align:center;color:#8c8c8c;padding:40px 10px;">😶‍🌫️ 查無符合條件的藥物</div>`;
  }
  document.getElementById("drugListToolbox").innerHTML = html;
}

function toggleTbWarn(i, el){
  let warn = document.getElementById("tbWarn" + i);
  let isHidden = warn.classList.contains("hidden");
  warn.classList.toggle("hidden");
  if(isHidden){
    el.innerHTML = "▼ 收起注意事項";
    warn.scrollIntoView({behavior:"smooth", block:"center"});
  } else {
    el.innerHTML = "▶ 點擊展開注意事項";
  }
}

function setCategory(cat){ currentCategory = cat; renderToolboxFront(); }
function setRisk(r){ currentRisk = r; renderToolboxFront(); }

function highlightFilter(el){
  let parent = el.parentElement;
  parent.querySelectorAll("button").forEach(btn=>btn.classList.remove("active"));
  el.classList.add("active");
}

document.getElementById("searchToolbox").addEventListener("input", renderToolboxFront);

/* TTS Speech */
let cachedVoice = null;
function pickVoice(){
  let voices = speechSynthesis.getVoices();
  cachedVoice = voices.find(v => /zh|Chinese/i.test(v.lang) && /female|女/i.test(v.name)) ||
                voices.find(v => /zh-TW|zh_TW/i.test(v.lang)) ||
                voices.find(v => /zh/i.test(v.lang)) || null;
}
if(typeof speechSynthesis !== "undefined"){
  pickVoice();
  speechSynthesis.onvoiceschanged = pickVoice;
}
function speakText(text){
  if(speechSynthesis.speaking) speechSynthesis.cancel();
  let u = new SpeechSynthesisUtterance(text);
  u.lang = "zh-TW";
  if(cachedVoice) u.voice = cachedVoice;
  u.pitch = 1.3; u.rate = 1.05; u.volume = 1;
  speechSynthesis.speak(u);
}
document.addEventListener("click", e=>{
  let nameEl = e.target.closest(".drug-name");
  if(nameEl){
    let card = nameEl.closest(".drug-card");
    let indication = card.querySelector("p").innerText;
    speakText(nameEl.innerText + "。" + indication);
  }
});

/* Toolbox Admin Auth & Functions */
async function sha256Hex(str){
  const enc = new TextEncoder().encode(str);
  const buf = await crypto.subtle.digest("SHA-256", enc);
  return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,"0")).join("");
}

async function doTbAdminLogin(){
  const errEl = document.getElementById("tbAdminErr");
  const now = Date.now();
  if(now < tbLockUntil){
    let secs = Math.ceil((tbLockUntil - now)/1000);
    errEl.textContent = `嘗試次數過多，請於 ${secs} 秒後再試`;
    return;
  }
  let val = document.getElementById("tbAdminPwd").value.trim();
  let hash;
  try { hash = await sha256Hex(val); } catch(e){ errEl.textContent = "驗證失敗，請確認環境 (需 HTTPS/localhost)"; return; }

  if(hash === ADMIN_PWD_HASH){
    tbFailCount = 0;
    tbAdminUnlocked = true;
    document.getElementById("tbAdminGate").classList.add("hidden");
    document.getElementById("tbAdminContent").classList.remove("hidden");
    document.getElementById("tbAdminPwd").value = "";
    errEl.textContent = "";
    renderTbAdmin();
  } else {
    tbFailCount++;
    if(tbFailCount >= 5){
      tbLockUntil = Date.now() + 30000;
      tbFailCount = 0;
      errEl.textContent = "嘗試次數過多，請於 30 秒後再試";
    } else {
      errEl.textContent = `密碼錯誤（剩餘 ${5 - tbFailCount} 次嘗試）`;
    }
  }
}

function lockTbAdmin(){
  tbAdminUnlocked = false;
  document.getElementById("tbAdminContent").classList.add("hidden");
  document.getElementById("tbAdminGate").classList.remove("hidden");
  showToast("🔒 後台已鎖定");
}

