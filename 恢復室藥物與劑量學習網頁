function openAddModalTB(){
  editTbIndex = -1;
  document.getElementById("tbModalTitle").textContent = "新增藥物";
  document.getElementById("fName").value = "";
  document.getElementById("fCategory").value = "止痛藥物";
  document.getElementById("fRisk").value = "high";
  document.getElementById("fIndication").value = "";
  document.getElementById("fAdr").value = "";
  document.getElementById("fDose").value = "";
  document.getElementById("fWarning").value = "";
  document.getElementById("fLowDose").value = "";
