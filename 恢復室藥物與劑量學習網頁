function doImportCalc(e){
  let file = e.target.files[0];
  if(!file) return;
  let reader = new FileReader();
  reader.onload = function(evt){
    try{
      let data = JSON.parse(evt.target.result);
      if(!Array.isArray(data)) throw new Error();
      if(!confirm(`即將匯入 ${data.length} 筆資料，將取代現有藥物。確定？`)) return;
      autoBackupCalc();
      calcDrugs = data;
      saveCalcDrugs();
      renderCalcAdminList();
      renderCalcSelect();
      showToast(`✅ 已成功匯入 ${data.length} 筆藥物`);
    }catch(err){ showToast("❌ 檔案解析失敗"); }
  };
