function closeCalcFormModal(){ document.getElementById("calcFormModal").classList.remove("show"); }

function saveCalcDrugForm(){
  let label = document.getElementById("calcFormLabel").value.trim();
  if(!label){ showToast("請輸入藥品顯示文字"); return; }

  let obj = {
    id: (editCalcIndex >= 0) ? calcDrugs[editCalcIndex].id : 'drug_' + Date.now(),
    label: label,
    type: document.getElementById("calcFormType").value,
    ctrl: document.getElementById("calcFormCtrl").checked
  };

  const fields = ['special','strength','amountunit','ampml','botml','totalml','totalamount','packcount','base','lowth'];
  fields.forEach(f => {
    let val = document.getElementById("calcForm" + f.charAt(0).toUpperCase() + f.slice(1)).value;
    if(val !== '') obj[f] = isNaN(val) ? val : parseFloat(val);
  });

  if(editCalcIndex >= 0) calcDrugs[editCalcIndex] = obj;
  else calcDrugs.push(obj);

  saveCalcDrugs();
  closeCalcFormModal();
  renderCalcAdminList();
  renderCalcSelect();
  showToast("✅ 劑量換算藥物已儲存");
}

function editCalcDrug(idx){ openDrugFormCalc(idx); }

function deleteCalcDrug(idx){
  if(!confirm(`確定要刪除「${calcDrugs[idx].label}」嗎？`)) return;
  autoBackupCalc();
  calcDrugs.splice(idx, 1);
  saveCalcDrugs();
  renderCalcAdminList();
  renderCalcSelect();
  showToast("🗑 藥物已刪除");
}

