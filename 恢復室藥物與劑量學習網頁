  e.target.value = "";
}

function doResetDefaultCalc(){
  if(!confirm("確定要重置為預設劑量換算清單嗎？")) return;
  autoBackupCalc();
  calcDrugs = JSON.parse(JSON.stringify(DEFAULT_CALC_DRUGS));
  saveCalcDrugs();
  renderCalcAdminList();
  renderCalcSelect();
  showToast("🔄 已重置為預設換算藥物");
}

function doRestoreBackupCalc(){
  let raw = localStorage.getItem(CALC_BACKUP_KEY);
  if(!raw){ showToast("目前沒有可復原的自動備份紀錄"); return; }
  let parsed = JSON.parse(raw);
  if(!confirm(`確定復原至 ${new Date(parsed.savedAt).toLocaleString()} 的自動備份？`)) return;
  calcDrugs = parsed.drugs || [];
  saveCalcDrugs();
  renderCalcAdminList();
  renderCalcSelect();
  showToast("↩ 已復原自動備份");
}

