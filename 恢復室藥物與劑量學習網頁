function doBackupCalc(){
  let blob = new Blob([JSON.stringify(calcDrugs, null, 2)], {type:"application/json"});
  let url = URL.createObjectURL(blob);
  let a = document.createElement("a");
  a.href = url;
  a.download = `劑量換算備份_${new Date().toISOString().slice(0,10)}.json`;
  a.click();
  URL.revokeObjectURL(url);
  showToast("📥 備份已下載");
